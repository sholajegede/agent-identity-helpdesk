# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Kinde web app (human sign-in)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/desk
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# Agent auth (set on the Convex deployment with `npx convex env set`)
KINDE_ISSUER=
KINDE_JWKS_URL=
KINDE_AUDIENCE=helpdesk-api

# Ticket agent M2M (own-identity mode)
TICKET_AGENT_CLIENT_ID=
TICKET_AGENT_CLIENT_SECRET=
# Refund agent M2M (broken / intersection modes)
REFUND_AGENT_CLIENT_ID=
REFUND_AGENT_CLIENT_SECRET=

# Management API M2M (resolve human permissions for intersection)
KINDE_MGMT_CLIENT_ID=
KINDE_MGMT_CLIENT_SECRET=

# Demo controls (server-decided) — app var, NOT the component's MODE
DEMO_MODE=shared-key
DEMO_MODE_SELECTABLE=true
DEMO_ORG_CODE=
DEMO_INTERN_SUBJECT=
DEMO_LEAD_SUBJECT=
DEMO_DEVELOPER_SUBJECT=

# --- Set these on the Convex DEPLOYMENT (npx convex env set), not in .env.local ---
# Component (agentAuth) required:
#   KINDE_DOMAIN=agentidentity.kinde.com   (no protocol)
#   KINDE_AUDIENCE=helpdesk-api
#   DELEGATION_SIGNING_SECRET=<openssl rand -hex 32>
#   MODE=live                              (component's test/live switch; live = real JWKS verify)
# App demo controls:
#   DEMO_MODE=shared-key                   (shared-key|scoped-key|own-identity|broken|intersection)
#   DEMO_MODE_SELECTABLE=true
