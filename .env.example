# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Kinde M2M agents. Read by the Next server and scripts/live-demo.mjs only.
KINDE_ISSUER=https://your-business.kinde.com
KINDE_AUDIENCE=helpdesk-api
TICKET_AGENT_CLIENT_ID=
TICKET_AGENT_CLIENT_SECRET=
REFUND_AGENT_CLIENT_ID=
REFUND_AGENT_CLIENT_SECRET=

# The demo desk
DEMO_ORG_CODE=org_demo
DEMO_INTERN_SUBJECT=kp_intern
DEMO_LEAD_SUBJECT=kp_lead

# Set these on the Convex deployment with `npx convex env set`, not here:
#   KINDE_DOMAIN=your-business.kinde.com   (no protocol)
#   KINDE_AUDIENCE=helpdesk-api
#   DELEGATION_SIGNING_SECRET=<openssl rand -hex 32>
#   MODE=live                              (the component's switch)
#   DEMO_MODE=shared-key                   (the app's default mode)
#   DEMO_MODE_SELECTABLE=true              (lets the console switch modes)
